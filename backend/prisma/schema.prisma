generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/* =========================
   ENUMS
========================= */
enum BookingStatus {
  PENDING
  CONFIRMED
  FAILED
  CANCELLED
}

enum BookingPaymentStatus {
  PENDING_ADVANCE
  ADVANCE_PAID
  FULLY_PAID
}

enum CouponType {
  AMOUNT
  PERCENT
}

enum RedemptionStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum TrekBlogStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
}

enum TrekReviewStatus {
  DRAFT
  APPROVED
  HIDDEN
}

/* =========================
   MODELS
========================= */

model Trek {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  description String
  location    String?
  duration         String
  difficulty       String
  season           String
  shortDescription String
  fullDescription  String
  price            String
  originalPrice    Int?
  discountedPrice  Int?
  coverImage       String
  gallery          Json
  headerPhotos     Json?
  morePhotos       Json?
  itinerary        Json
  contentBlocks    Json?
  isActive         Boolean  @default(true)
  createdAt   DateTime @default(now())

  departures  Departure[]
  bookings    Booking[]
  blogs       TrekBlog[]
  reviews     TrekReview[]
}

model Departure {
  id            String   @id @default(uuid())
  trekId        String
  startDate     DateTime
  endDate       DateTime
  totalSeats   Int
  bookedSeats  Int      @default(0)
  pricePerSeat Int
  createdAt    DateTime @default(now())

  trek      Trek      @relation(fields: [trekId], references: [id])
  bookings  Booking[]
}

model Customer {
  id        String   @id @default(uuid())
  fullName String
  email    String   @unique
  phone    String
  creditBalance Int  @default(0)
  createdAt DateTime @default(now())

  bookings Booking[]
}

model Booking {
  id                String   @id @default(uuid())
  trekkingId        String   @unique

  trekId            String
  departureId       String
  customerId        String

  numberOfSeats     Int
  totalAmount       Int
  discountAmount    Int      @default(0)
  finalAmount       Int      @default(0)
  couponId          String?
  amountPaid        Int      @default(0)
  amountDue         Int      @default(0)
  creditUsed        Int      @default(0)
  creditGranted     Int      @default(0)
  advanceAmount     Int      @default(500)
  fullPaymentDiscountPercent Int @default(10)
  paymentStatus     BookingPaymentStatus @default(PENDING_ADVANCE)
  dueReminderSentAt DateTime?
  welcomeSentAt     DateTime?
  cancelledAt       DateTime?

  status            BookingStatus @default(PENDING)

  razorpayOrderId    String? @unique
  razorpayPaymentId String? @unique
  razorpaySignature String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  trek       Trek      @relation(fields: [trekId], references: [id])
  departure  Departure @relation(fields: [departureId], references: [id])
  customer   Customer  @relation(fields: [customerId], references: [id])
  coupon     Coupon?   @relation(fields: [couponId], references: [id])
  payments   Payment[]
  redemptions CouponRedemption[]

  @@index([trekId])
  @@index([departureId])
  @@index([customerId])
}

model Coupon {
  id              String   @id @default(uuid())
  code            String   @unique
  type            CouponType
  value           Int
  validFrom       DateTime?
  validTo         DateTime?
  maxUses         Int?
  maxUsesPerEmail Int?
  minAmount       Int?
  usedCount       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  redemptions CouponRedemption[]
  bookings    Booking[]
}

model CouponRedemption {
  id           String           @id @default(uuid())
  couponId     String
  bookingId    String
  customerEmail String
  status       RedemptionStatus @default(PENDING)
  createdAt    DateTime         @default(now())

  coupon   Coupon  @relation(fields: [couponId], references: [id])
  booking  Booking @relation(fields: [bookingId], references: [id])

  @@index([couponId])
  @@index([bookingId])
}

model Payment {
  id         String   @id @default(uuid())
  bookingId  String
  provider   String
  amount     Int
  status     String
  stage      String   @default("ADVANCE")
  orderId    String?
  paymentId  String?
  signature  String?
  createdAt  DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
}

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())

  loginOtps AdminLoginOtp[]
}

model AdminLoginOtp {
  id          String    @id @default(uuid())
  adminUserId String
  codeHash    String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  adminUser AdminUser @relation(fields: [adminUserId], references: [id])

  @@index([adminUserId])
  @@index([expiresAt])
}

model EmailLog {
  id        String   @id @default(uuid())
  to        String
  subject   String
  status    String
  error     String?
  bookingId String?
  createdAt DateTime @default(now())
}

model PageFaq {
  id        String   @id @default(uuid())
  pageKey   String
  question  String
  answer    String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageKey, isActive, sortOrder])
}

model TrekBlog {
  id                     String         @id @default(uuid())
  trekId                 String
  title                  String
  slug                   String
  author                 String
  status                 TrekBlogStatus @default(DRAFT)
  shortIntro             String
  content                String
  personalExperience     String?
  highlights             Json?
  lessonsLearned         String?
  itinerary              Json?
  videoUrl               String?
  featuredImage          String?
  gallery                Json?
  imageAltText           String?
  bestTimeToVisit        String?
  temperatureRange       String?
  fitnessLevelRequired   String?
  gearList               Json?
  permitsRequired        Boolean        @default(false)
  permitsDescription     String?
  estimatedCost          String?
  metaTitle              String?
  metaDescription        String?
  keywords               Json?
  openGraphImage         String?
  publishAt              DateTime?
  featured               Boolean        @default(false)
  showOnHomepage         Boolean        @default(false)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  trek Trek @relation(fields: [trekId], references: [id])

  @@unique([slug])
  @@index([trekId])
}

model TrekReview {
  id               String           @id @default(uuid())
  trekId           String
  reviewerName     String
  reviewerPhotoUrl String?
  rating           Int
  reviewTitle      String?
  reviewText       String
  trekDate         DateTime?
  location         String?
  recommend        Boolean          @default(true)
  featured         Boolean          @default(false)
  status           TrekReviewStatus @default(DRAFT)
  displayOrder     Int?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  trek Trek @relation(fields: [trekId], references: [id])

  @@index([trekId])
  @@index([status])
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([email])
}

model NewsletterSubscriber {
  id         String   @id @default(uuid())
  email      String   @unique
  sourcePath String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
