{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",                  // include server + shared
    "outDir": "../dist/server",
    "module": "CommonJS",
    "target": "ES2020",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "baseUrl": "..",
    "paths": {
      "@shared/*": ["shared/*"]
    }
  },
  "include": ["./**/*.ts", "../shared/**/*.ts"],   // FIXED relative paths
  "exclude": ["node_modules", "../dist", "../client"]
}
