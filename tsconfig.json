{
  //"include": ["client/src/**/*", "shared/**/*"],
  "exclude": ["node_modules", "dist", "build", "server"],

  "compilerOptions": {
  "incremental": true,
  "noEmit": true,
  "target": "ES2020",
  "module": "ESNext",
  "moduleResolution": "node",
  "strict": true,
  "lib": ["ES2020", "DOM"],
  "jsx": "preserve",
  "esModuleInterop": true,
  "skipLibCheck": true,
  "baseUrl": ".",
  "types": ["node"],
  "paths": {
    "@/*": ["client/src/*"],
    "@shared/*": ["shared/*"]
  }
}
}
